import java.util.*;

class RotationOfString{
    public static void main(String args[])
    {
        Scanner sc=new Scanner(System.in);
        System.out.print("enter the text1: ");
        String text1=sc.nextLine();
        
        System.out.print("enter the text2: ");
        String text2=sc.nextLine();
        
        if(text1.length()!=text2.length())
        {
            System.out.println("it is not rotation of a string ");
            System.exit(0);
        }
        
        String text3=text1+text1;
        
        if(text3.indexOf(text2)!=-1)
        {
            System.out.println("it is rotation of a string ");
        }
        else{
            System.out.println("it is not a rotation of a string");
        }
    }
}
